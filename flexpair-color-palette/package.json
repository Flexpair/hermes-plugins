{
  "name": "flexpair-color-palette",
  "version": "1.0.0",
  "private": true,
  "description": "Fixed Flexpair accents and 150% zoom for Hermes Desktop, without a picker.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "npm run build && node --experimental-vm-modules --test test/*.test.mjs",
